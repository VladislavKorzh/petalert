[Unit]
Description=petalert — Telegram alerts for new house-sits
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=petalert
Group=petalert
# Код (власник deploy) окремо від стану (власник petalert): сервіс не може
# переписати власний код, а пише лише в /var/lib/petalert.
WorkingDirectory=/srv/petalert
# uv потрібен лише на деплої (`uv sync --frozen --no-dev`); тут — готовий venv.
ExecStart=/srv/petalert/.venv/bin/python -m petalert
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/petalert

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/petalert
# Спокійний процес займає ~180 МБ (aiogram тягне всі pydantic-моделі Bot API);
# запас — на повний обхід у 10 сторінок. На малому VPS поруч живуть інші сервіси.
MemoryHigh=300M
MemoryMax=400M

[Install]
WantedBy=multi-user.target
