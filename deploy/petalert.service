[Unit]
Description=petalert — Telegram alerts for new house-sits
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=petalert
Group=petalert
# Code (owned by deploy) is separate from state (owned by petalert): the service
# can't rewrite its own code and only writes to /var/lib/petalert.
WorkingDirectory=/srv/petalert
# uv is only needed at deploy time (`uv sync --frozen --no-dev`); this is the built venv.
ExecStart=/srv/petalert/.venv/bin/python -m petalert
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/petalert

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/petalert
# At rest the process uses ~180 MB (aiogram loads every pydantic model of the
# Bot API); the headroom is for a 10-page full crawl. On a small VPS other
# services live alongside.
MemoryHigh=300M
MemoryMax=400M

[Install]
WantedBy=multi-user.target
