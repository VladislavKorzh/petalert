# petalert config. Process environment variables override values from this file
# (on a server, systemd can override anything without editing .env).

# Token from @BotFather. Locally, use a SEPARATE dev bot: two polling processes
# on the same token cause TelegramConflictError.
BOT_TOKEN=

# Comma-separated Telegram user_ids of admins. Admins get access without an invite code.
ADMIN_USER_IDS=
# Where to send health alerts (source down, api-version changed, etc.).
# Usually your own user_id. Empty = log only.
ADMIN_CHAT_ID=

# Residential rotating proxy (e.g. Decodo). Empty = direct requests only.
# Format: http://user-USERNAME:PASSWORD@gate.decodo.com:7000
# THS blocks datacenter IPs (e.g. DigitalOcean), so on a VPS this is required.
PROXY_URL=
# fallback — proxy only on retries after 403/429/5xx;
# always — every request goes through the proxy (use this on a VPS).
PROXY_MODE=fallback

POLL_INTERVAL_MIN=30
# A full crawl finds dates added to old listings without a bump (~0.5% of new
# slots). It costs ~results/100 requests per distinct filter (≈120 KB each via
# a proxy), so a shorter interval = fresher alerts but more proxy traffic.
FULL_CRAWL_HOURS=3
DB_PATH=var/petalert.sqlite3

# api-version header for THS. On a 406 the bot re-reads it from the site and
# tells the admin — update it here then as well.
THS_API_VERSION=2025-08-14
