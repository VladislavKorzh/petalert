# Конфіг petalert. Змінні оточення процесу перекривають значення з цього файлу
# (на дроплеті systemd може перебити будь-що, не правлячи .env).

# Токен від @BotFather. Локально — ОКРЕМИЙ dev-бот: два polling-процеси на
# одному токені дають TelegramConflictError.
BOT_TOKEN=

# Telegram user_id адмінів через кому. Адміни мають доступ без інвайт-коду.
ADMIN_USER_IDS=
# Куди слати health-алерти (джерело лежить, змінилась api-version тощо).
# Зазвичай це ваш user_id. Порожньо — лише в лог.
ADMIN_CHAT_ID=

# Вендор: Decodo (резидентні, rotating). Порожньо — лише прямі запити.
# Формат: http://user-USERNAME:PASSWORD@gate.decodo.com:7000
PROXY_URL=
# fallback — проксі лише на повторних спробах після 403/429/5xx;
# always — кожен запит через проксі.
PROXY_MODE=fallback

POLL_INTERVAL_MIN=30
DB_PATH=var/petalert.sqlite3

# Заголовок api-version для THS. При 406 бот сам перечитує його зі сторінки
# сайту й повідомляє адміна — тоді варто оновити й тут.
THS_API_VERSION=2025-08-14
